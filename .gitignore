# Règle du dépôt (décision du propriétaire, 09/11/2026) : on pousse TOUT ce qui sert ou
# pourra servir (code, scripts, firmware et applis système Topway/AOSP de l'unité, outils
# libres), SAUF :
#   - les journaux exportés par Sandero (titres de musique, noms de téléphone…) ;
#   - les identifiants personnels de l'unité (numéro de série, licence OTA, secret réseau,
#     adresses MAC, UID/UUID, Config.dat) ;
#   - les APK de tiers sans droit de redistribution (Google, Waze, Spotify, Torque…).
# Gros fichiers (> 50 Mo) : Git LFS, voir .gitattributes.

# --- Journaux et exports de Sandero (données personnelles) ---------------------
SanderoExport_*/
SanderoImage_*/
journal*.txt
plantages.txt
twutil_*.txt
UID.txt
UUID.txt
Config.dat

# --- Sorties brutes des scripts ADB (avant nettoyage des identifiants) -----------
# Dump ADB brut (getprop non masqué) : à fusionner dans autoradio/systeme_* après nettoyage.
autoradio/dumps/
# Relevés de Boot_Origine.bat (/proc/cmdline peut contenir numéro de série et MAC).
autoradio/images/releves.txt
autoradio/images/su.txt
autoradio/images/partitions.txt
# Partitions propres à l'unité (numéro de série, MAC, clés) ou trop grosses pour le quota LFS.
autoradio/images/env.img
autoradio/images/private.img
autoradio/images/misc.img
autoradio/images/frp.img
autoradio/images/metadata.img
autoradio/images/cache.img
autoradio/images/empty.img
autoradio/images/media_data.img
autoradio/images/UDISK.img
autoradio/images/system.img
autoradio/images/vendor.img
autoradio/allegement/r.txt
autoradio/allegement/pss.txt

# --- APK de tiers sans droit de redistribution, où qu'ils soient -----------------
**/GmsCore/
**/Phonesky/
**/Chrome/
**/WebViewGoogle/
**/GoogleServicesFramework/
**/GooglePartnerSetup/
**/GooglePackageInstaller/
**/GoogleExtServices/
**/GoogleExtShared/
*com.google.android.*.apk
*com.android.vending*.apk
*com.android.chrome*.apk
*com.waze*.apk
*org.prowl.torque*.apk
*com.ex.dabplayer*.apk
*com.spotify*.apk

# --- Android / Gradle ---------------------------------------------------------
SanderoLauncher/local.properties
SanderoLauncher/.gradle/
SanderoLauncher/.idea/
SanderoLauncher/build/
SanderoLauncher/app/build/
SanderoLauncher/captures/
*.iml
*.jks
*.keystore

# --- Divers --------------------------------------------------------------------
.DS_Store
Thumbs.db
desktop.ini
__pycache__/
*.pyc
.claude/settings.local.json

