<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Outils d'export : lire le stockage et écrire sur la clé USB -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" />
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" />
    <!-- Lancement automatique au démarrage de l'autoradio -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <!-- Allègement : arrêter les applis en arrière-plan -->
    <uses-permission android:name="android.permission.KILL_BACKGROUND_PROCESSES" />
    <!-- Débogage USB sans mot de passe Topway : accordée seulement si le système l'autorise -->
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Caméra de recul intégrée -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Recevoir aussi les annonces Bluetooth Android standard -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <!-- OBD2 : recherche d'un module ELM327 Bluetooth, module Wi-Fi (TCP) -->
    <uses-permission android:name="android.permission.BLUETOOTH_ADMIN" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- OBD2 en USB : facultatif, l'appli s'installe aussi sans -->
    <uses-feature android:name="android.hardware.usb.host" android:required="false" />
    <uses-feature android:name="android.hardware.bluetooth" android:required="false" />
    <!-- Recalage de l'heure sur le GPS -->
    <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
    <!-- Service permanent et retour automatique à Sandero -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />

    <application
        android:name=".SanderoApp"
        android:label="Sandero"
        android:icon="@drawable/ic_launcher"
        android:theme="@style/LauncherTheme"
        android:allowBackup="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|navigation|density|locale">

            <!-- Visible dans la liste des applis, pour tester sans tout changer -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Peut devenir l'écran d'accueil -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <activity
            android:name=".ToolsActivity"
            android:label="Outils Sandero"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|navigation|density|locale" />

        <activity
            android:name=".TwMonitorActivity"
            android:label="Moniteur TWUtil"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|navigation|density|locale" />

        <activity
            android:name=".ObdActivity"
            android:label="OBD2"
            android:exported="false"
            android:launchMode="singleTask"
            android:screenOrientation="sensorLandscape"
            android:windowSoftInputMode="adjustResize"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|navigation|density|locale" />

        <activity
            android:name=".SystemActivity"
            android:label="Système Sandero"
            android:exported="false"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|navigation|density|locale" />

        <activity
            android:name=".ReverseCamActivity"
            android:label="Caméra de recul"
            android:exported="false"
            android:launchMode="singleTask"
            android:taskAffinity="fr.sandero.launcher.reverse"
            android:excludeFromRecents="true"
            android:theme="@style/LauncherTheme"
            android:screenOrientation="sensorLandscape"
            android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|navigation|density|locale" />

        <service
            android:name=".SanderoService"
            android:exported="false" />

        <receiver
            android:name=".BootReceiver"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
            </intent-filter>
        </receiver>

        <!-- Permet d'afficher le titre et la pochette du morceau en cours
             (à autoriser dans Réglages > Accès aux notifications). -->
        <service
            android:name=".MediaListener"
            android:label="Sandero (titres musique)"
            android:exported="true"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>
    </application>
</manifest>
